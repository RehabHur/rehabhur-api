// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  docente
  estudiante
  paciente
}

model Person {
  id          Int    @id @default(autoincrement())
  firstName   String
  lastName    String @map("last_name")
  email       String @unique
  dni         String @unique
  nationality String
  role        Role 

  @@map("persons")
}


model Commission {
  id           Int      @id @default(autoincrement())
  name         String   @unique 
  year         Int
  turno        String   // "Mañana", "Tarde", "Noche"
  cuatrimestre Int      // 1 o 2
  createdAt    DateTime @default(now())

  teachers  Teacher[]
  students Student[]

  @@map("commissions")
}


model Teacher {
  id         Int    @id @default(autoincrement())
  name       String
  last_name  String
  email      String @unique
  dni        String @unique
  commissions Commission[]

  @@map("teachers")
}


model Patient {
  id        Int       @id @default(autoincrement())
  name      String
  last_name String
  email     String    @unique
  dni       String    @unique
  students  Student[]

  @@map("patients")
}

model Student {
  id           Int         @id @default(autoincrement())
  name         String
  last_name    String
  email        String      @unique
  dni          String      @unique
  commissionId Int?
  commission   Commission? @relation(fields: [commissionId], references: [id])
  patients     Patient[]

  @@map("students")
}





model Exercise {
  id           Int    @id @default(autoincrement())
  name         String
  bodyRegion   String
  motionType   String
  material     String
  linkVideo    String @unique
  instructions String


  @@unique([name, bodyRegion])
  @@map("exercises")
}


